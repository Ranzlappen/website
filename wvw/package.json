{
  "name": "wvw-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "WvW Hub \u2014 global Guild Wars 2 World vs. World raid calendar + guild directory (ranzlappen.com/wvw/).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run && node scripts/check-mirror.mjs",
    "test:watch": "vitest",
    "preview": "vite preview",
    "format": "prettier --write src/",
    "check:mirror": "node scripts/check-mirror.mjs",
    "build:maps": "python3 -I scripts/build-maps.py"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.4",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
